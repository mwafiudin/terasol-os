# Superuser Postgres — hanya untuk migrasi & pembuatan role aplikasi.
# Di Railway ini diisi otomatis lewat reference ${{Postgres.DATABASE_URL}}.
# Untuk lokal, buka tunnel dulu:
#   railway connect Postgres --tunnel-only --port 55432
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:55432/railway

# TLS ke Postgres (src/tls.ts): localhost, *.railway.internal, dan nama satu
# kata (service docker `postgres`) tanpa TLS; host lain memakai TLS yang
# memverifikasi sertifikat. ?sslmode=disable di URL tetap dihormati.
# Opsional: CA sendiri (teks PEM) bila sertifikat server tidak ditandatangani CA publik.
# DATABASE_CA_CERT=
# Opsional, HANYA untuk laptop lewat proxy publik Railway (*.proxy.rlwy.net,
# sertifikatnya self-signed): 1 = sertifikat tidak diverifikasi, dan setiap
# koneksi mencetak peringatan. Jangan dipasang di server.
# DATABASE_TLS_TANPA_VERIFIKASI=

# Role aplikasi: bukan superuser dan bukan pemilik tabel, sehingga RLS berlaku.
# Dibuat/disegarkan otomatis setiap migrasi jalan.
APP_DB_USER=terasol_app
APP_DB_PASSWORD=ganti-dengan-nilai-acak-panjang

JWT_SECRET=ganti-dengan-nilai-acak-panjang
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

NODE_ENV=development
PORT=3000
# Di produksi isi dengan domain aplikasi web, bukan *
CORS_ORIGIN=*

# Opsional — membuat tenant + akun admin saat deploy pertama.
# Dilewati bila sudah ada user, jadi aman dibiarkan terpasang.
BOOTSTRAP_TENANT=Cabang Menteng
BOOTSTRAP_EMAIL=admin@terasol.id
BOOTSTRAP_NAMA=Admin Pusat
BOOTSTRAP_PASSWORD=ganti-saya

# Dipakai `npm run purge`. Sengaja tanpa default — durasi retensi data peserta
# adalah keputusan terbuka (PRD D5) yang perlu verifikasi hukum.
# RETENTION_DAYS=365

# Kata sandi akun demo yang dibuat `npm run seed` di tenant "Cabang Demo".
# Wajib minimal 12 karakter dan sebaiknya acak: akun demo tetap tinggal di
# basis data produksi, jadi kekuatannya nyata, bukan formalitas.
# Nilai yang sama dipakai di VITE_DEMO_LOGINS pada apps/web/.env.local.
# DEMO_PASSWORD=

{
  "name": "terasol-os-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node --env-file-if-exists=.env dist/cli-migrate.js",
    "seed": "node --env-file-if-exists=.env dist/cli-seed.js",
    "purge": "node --env-file-if-exists=.env dist/cli-purge.js",
    "test": "npm run build && node --env-file-if-exists=.env --test test/password.test.js test/security.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}

# syntax=docker/dockerfile:1
# Image web untuk self-host: build Vite statis, lalu disajikan nginx tanpa root.
# Namanya bukan `Dockerfile` supaya Railway tidak otomatis memakainya.
# Cara pakai: docs/self-host.md.
#
# Base dipaku ke digest indeks multi-arch, bukan cuma tag. Menaikkan versi =
# ganti baris FROM dengan hasil `docker buildx imagetools inspect <tag>`.

FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Ditanam ke bundle saat build, jadi ganti URL API = build ulang image.
# Sengaja tanpa default: image yang lupa diisi akan memanggil origin-nya
# sendiri dan gagal diam-diam di perangkat petugas.
ARG VITE_API_URL
RUN test -n "$VITE_API_URL" || { echo "build arg VITE_API_URL wajib diisi" >&2; exit 1; }
RUN npm run build \
 && if find dist -name '*.map' | grep -q .; then echo "sourcemap ikut ter-build" >&2; exit 1; fi

FROM nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8 AS jalan
# Image ini sudah berjalan sebagai uid 101 dan mendengar di 8080, jadi tidak
# butuh hak root untuk port di bawah 1024.
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/header-aman.conf /etc/nginx/snippets/header-aman.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/"]

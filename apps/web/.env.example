# Salin ke .env.local (tidak masuk git), lalu isi.

# URL API Terasol OS. Wajib — nilainya ditanam ke bundle saat build.
VITE_API_URL=https://api-production-21af.up.railway.app

# Tombol "masuk cepat" per peran di layar login — HANYA untuk pengembangan lokal.
#
# Dua pengaman, keduanya harus lolos sebelum tombolnya muncul:
#   1. `import.meta.env.DEV` — di build produksi jadi literal false, sehingga
#      seluruh blok (JSX, CSS, dan fungsi pembacanya) dibuang bundler.
#   2. Variabel ini hanya ada di .env.local yang masuk .gitignore dan
#      .railwayignore, jadi tidak pernah sampai ke repo maupun server build.
#
# Kata sandinya harus sama dengan DEMO_PASSWORD di apps/api/.env — akun demo
# dibuat oleh `npm run seed` di tenant terpisah "Cabang Demo".
#
# VITE_DEMO_LOGINS='[{"label":"Petugas","role":"petugas","email":"petugas.demo@terasol.id","password":"..."},{"label":"Koordinator","role":"koordinator","email":"koordinator.demo@terasol.id","password":"..."},{"label":"Admin Pusat","role":"admin_pusat","email":"pusat.demo@terasol.id","password":"..."}]'
